doctype html
html(lang='en')

    head

        meta(charset='utf-8')
        meta(name='viewport', content='width=device-width, initial-scale=1, shrink-to-fit=no')
        meta(name='description', content='')
        meta(name='author', content='')

        title DimenCreat

        // Favicon
        link(rel='icon', type='image/x-icon', href='assets/favicon.ico')

        include includes/css.pug

    body.d-flex.flex-column.h-100

        main.flex-shrink-0

            // Navigation
            include includes/navbar.pug

            // Header
            header.bg-dark.py-5
                .container.px-5
                    .row.gx-5.align-items-center.justify-content-center
                        .col-lg-8.col-xl-7.col-xxl-6
                            .my-5.text-center.text-xl-start
                                h1.display-5.fw-bolder.text-white.mb-2 Step into a world where creativity meets culture. 
                                p.lead.fw-normal.text-white-50.mb-4 At DimenCreat, we bring anime fans, creators, and industry leaders together through our innovative anime networking app. Connect with like-minded enthusiasts, share your creativity, and explore exclusive content. Celebrate anime, art, and community with us—your gateway to an exciting anime world!
                                .d-grid.gap-3.d-sm-flex.justify-content-sm-center.justify-content-xl-start
                                    a.btn.btn-primary.btn-lg.px-4.me-sm-3(href='#features') Get Started
                        .col-xl-5.col-xxl-6.d-none.d-xl-block.text-center
                            .scroll-container
                                img.img-fluid.rounded-3.my-5(src='../assets/appletea.png', alt='Image 1')
                                img.img-fluid.rounded-3.my-5(src='../assets/image1.png', alt='Image 2')
                                img.img-fluid.rounded-3.my-5(src='../assets/image2.png', alt='Image 3')
                           

            // Features section
            section#features.py-5
                .container.px-5.my-5
                    .row.gx-5
                        .col-lg-4.mb-5.mb-lg-0
                            h2.fw-bolder.mb-0 Bringing Anime Culture to Life.
                        .col-lg-8
                            .row.gx-5.row-cols-1.row-cols-md-2
                                .col.mb-5.h-100
                                    .feature.bg-primary.bg-gradient.text-white.rounded-3.mb-3
                                        i.bi.bi-collection
                                    h2.h5 NekoTalk: Anime Social App
                                    p.mb-0
                                        | Discover a vibrant social platform for anime enthusiasts. Share your fan art, cosplay, and reviews, explore endless anime content.
                                .col.mb-5.h-100
                                    .feature.bg-primary.bg-gradient.text-white.rounded-3.mb-3
                                        i.bi.bi-building
                                    h2.h5 AppleTea: Virtual Idol
                                    p.mb-0
                                        | Meet AppleTea, the virtual idol combining technology and creativity.
                                .col.mb-5.mb-md-0.h-100
                                    .feature.bg-primary.bg-gradient.text-white.rounded-3.mb-3
                                        i.bi.bi-toggles2
                                    h2.h5 SeiyuClub: Voice Actor Hub
                                    p.mb-0
                                        | Step into the world of voice acting with SeiyuClub. Connect with voice actors, enjoy exclusive content.
                                .col.h-100
                                    .feature.bg-primary.bg-gradient.text-white.rounded-3.mb-3
                                        i.bi.bi-toggles2
                                    h2.h5 Creator Platform
                                    p.mb-0
                                        |Support talented creators or showcase your own work!
            .py-5.bg-light
                .container.px-5.my-5
                    .row.gx-5.justify-content-center
                        .col-lg-10.col-xl-7
                            .text-center
                                .fs-4.mb-4.fst-italic “Joining DimenCreat has allowed me to better share my creations with a passionate audience. With their support, showcasing my work to readers and fans has never been easier!”
                                .d-flex.align-items-center.justify-content-center
                                    img.rounded-circle.me-3(src='../assets/creator.png', alt='...')
                                    .fw-bold
                                        | sukikitty
                                        span.fw-bold.text-primary.mx-1 /
                                        |  A DimenCreat-supported Creator

            // Blog preview section
            section.py-5
                .container.px-5.my-5
                    .row.gx-5.justify-content-center
                        .col-lg-8.col-xl-6
                            .text-center
                                h2.fw-bolder From our News
                                p.lead.fw-normal.text-muted.mb-5 Connecting fans, creators, and communities through passion and creativity. Explore, share, and celebrate a vibrant world of anime culture.
                    .row.gx-5
                        .col-lg-4.mb-5
                            .card.h-100.shadow.border-0
                                img.card-img-top(src='../assets/anime.jpg', alt='...')
                                .card-body.p-4
                                    .badge.bg-primary.bg-gradient.rounded-pill.mb-2 News
                                    a.text-decoration-none.link-dark.stretched-link(href='blog-post.html')
                                        h5.card-title.mb-3 DimenCreat Employees Attend CP20 Anime Expo
                                    p.card-text.mb-0
                                        | We recently participated in the CP20 Anime Expo, a premier event that brings together anime enthusiasts, creators, and industry leaders. 
                                .card-footer.p-4.pt-0.bg-transparent.border-top-0
                                    .d-flex.align-items-end.justify-content-between
                                        .d-flex.align-items-center
                                            img.rounded-circle.me-3(src='../assets/profile.png', alt='...')
                                            .small
                                                .fw-bold MeowDimen
                                                .text-muted Agu 17, 2024 
                        .col-lg-4.mb-5
                            .card.h-100.shadow.border-0
                                img.card-img-top(src='../assets/appletea.png', alt='...')
                                .card-body.p-4
                                    .badge.bg-primary.bg-gradient.rounded-pill.mb-2 News
                                    a.text-decoration-none.link-dark.stretched-link(href='blog-post1.html')
                                        h5.card-title.mb-3 Virtual Idol AppleTea’s Birthday Celebration on July 19
                                    p.card-text.mb-0
                                        | AppleTea, DimenCreat’s beloved virtual idol, celebrated her birthday on July 19 with a spectacular online event.
                                .card-footer.p-4.pt-0.bg-transparent.border-top-0
                                    .d-flex.align-items-end.justify-content-between
                                        .d-flex.align-items-center
                                            img.rounded-circle.me-3(src='../assets/profile2.png', alt='...')
                                            .small
                                                .fw-bold appleFUN
                                                .text-muted Jul 19, 2024 
                        .col-lg-4.mb-5
                            .card.h-100.shadow.border-0
                                img.card-img-top(src='../assets/profile3.png', alt='...')
                                .card-body.p-4
                                    .badge.bg-primary.bg-gradient.rounded-pill.mb-2 News
                                    a.text-decoration-none.link-dark.stretched-link(href='blog-post2.html')
                                        h5.card-title.mb-3 NekoTalk Launches User Reward Platform
                                    p.card-text.mb-0
                                        | NekoTalk introduces its new User Reward Platform, allowing fans to earn points and exclusive perks by engaging with content and participating in community activities. 
                                .card-footer.p-4.pt-0.bg-transparent.border-top-0
                                    .d-flex.align-items-end.justify-content-between
                                        .d-flex.align-items-center
                                            img.rounded-circle.me-3(src='../assets/profile4.png', alt='...')
                                            .small
                                                .fw-bold DimenSupport
                                                .text-muted April 2, 2023

                    // Call to action
                    aside.bg-primary.bg-gradient.rounded-3.p-4.p-sm-5.mt-5
                        .d-flex.align-items-center.justify-content-between.flex-column.flex-xl-row.text-center.text-xl-start
                            .mb-4.mb-xl-0
                                .fs-3.fw-bold.text-white Stay updated with the world of anime!
                                .text-white-50 Sign up for Nekotalk for the latest updates.
                            .ms-xl-4
                                .input-group.mb-2
                                    input.form-control(type='text', placeholder='Email address...', aria-label='Email address...', aria-describedby='button-newsletter')
                                    button#button-newsletter.btn.btn-outline-light(type='button') Sign up
                                .small.text-white-50 We care about privacy, and will never share your data.

        // Footer
        include includes/footer.pug

        include includes/scripts.pug
