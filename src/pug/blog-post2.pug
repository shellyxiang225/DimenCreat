doctype html
html(lang='en')

    head

        meta(charset='utf-8')
        meta(name='viewport', content='width=device-width, initial-scale=1, shrink-to-fit=no')
        meta(name='description', content='')
        meta(name='author', content='')

        title DimenCreat

        // Favicon
        link(rel='icon', type='image/x-icon', href='assets/favicon.ico')

        include includes/css.pug

    body.d-flex.flex-column

        main.flex-shrink-0

            // Navigation
            include includes/navbar.pug

            // Page Content
            section.py-5
                .container.px-5.my-5

                    .row.gx-5

                        .col-lg-3
                            .d-flex.align-items-center.mt-lg-5.mb-4
                                img.img-fluid.rounded-circle(src='../assets/profile4.png', alt='...')
                                .ms-3
                                    .fw-bold DimenSupport
                                    .text-muted News

                        .col-lg-9

                            // Post content
                            article

                                // Post header
                                header.mb-4

                                    // Post title
                                    h1.fw-bolder.mb-1 NekoTalk Launches User Reward Platform

                                    // Post meta content
                                    .text-muted.fst-italic.mb-2 April 2, 2023


                                    // Post categories
                                    a.badge.bg-secondary.text-decoration-none.link-light(href='#!') News
                                    a.badge.bg-secondary.text-decoration-none.link-light(href='#!') About Dimen

                                // Preview image figure
                                figure.mb-4
                                    img.img-fluid.rounded(src='../assets/profile3.png', alt='...')

                                // Post content
                                section.mb-5

                                    p.fs-5.mb-4 NekoTalk proudly introduces its new User Reward Platform, a dynamic system designed to enhance user engagement and reward loyal fans.
                                    p.fs-5.mb-4 With this platform, users can earn points by participating in various activities, such as sharing content, commenting on posts, and interacting with their favorite creators. 
                                    p.fs-5.mb-4 These points can then be redeemed for exclusive perks, including access to special events, unique collectibles, and personalized shoutouts from creators. 
                                    p.fs-5.mb-4 This initiative not only encourages a more vibrant and interactive community but also provides fans with a meaningful way to support the creators they love.
                                    p.fs-5.mb-4 By bridging the gap between fans and creators, the User Reward Platform embodies NekoTalk’s mission to create a thriving ecosystem for anime enthusiasts.
                            // Comments section
                            section
                                .card.bg-light
                                    .card-body

                                        // Comment form
                                        form.mb-4
                                            textarea.form-control(rows='3', placeholder='Join the discussion and leave a comment!')

                                        // Comment with nested comments
                                        .d-flex.mb-4


                                        // Single comment
                                        .d-flex
                                            .flex-shrink-0
                                                img.rounded-circle(src='assets/profile4.png', alt='...')
                                            .ms-3
                                                .fw-bold DimenSupport
                                                | Beep boop! This is absolutely amazing!🤖

        // Footer
        include includes/footer.pug

        include includes/scripts.pug
